# Configuración local: copia este archivo a .env y completa los valores de Azure.
AZURE_MYSQL_HOST=tu-servidor.mysql.database.azure.com
AZURE_MYSQL_PORT=3306
AZURE_MYSQL_DATABASE=proyecto_tbd
AZURE_MYSQL_USER=tu_usuario
AZURE_MYSQL_PASSWORD=tu_contrasena

# Clave para AES_ENCRYPT/AES_DECRYPT. Mantén el mismo valor para poder descifrar.
AZURE_MYSQL_AES_KEY=cambia-esto-por-una-clave-aleatoria-larga

# Opcional: ruta al certificado CA de Azure si lo necesitas en tu equipo.
AZURE_MYSQL_SSL_CA=
